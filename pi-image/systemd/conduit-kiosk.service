[Unit]
Description=Conduit kiosk (Chromium)
After=graphical.target network-online.target conduit-boot-update.service
Wants=network-online.target

[Service]
User=pi
Environment=DISPLAY=:0
ExecStart=/opt/conduit/kiosk.sh
# Watchdog: relaunch Chromium if it crashes or is closed.
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
