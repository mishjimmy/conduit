# Caddy reverse proxy for Conduit, serving over the internal CA on conduit.local.
#
# The Pi kiosk loads https://player.conduit.local; operators use https://conduit.local.
# (To serve the player under conduit.local/player instead, set basePath in the
# player's next.config and make its client fetches basePath-aware.)

{
	# Issue certs from Caddy's local internal CA. Trust this CA on every device:
	# the CA root is baked into the Pi image and installed in operator browsers.
	local_certs
}

conduit.local {
	# CMS (management UI)
	reverse_proxy cms:3000

	# Appwrite API — proxy under the same origin so the browser session cookie
	# powers Realtime. Point this at your Appwrite host.
	handle_path /v1/* {
		reverse_proxy appwrite:80
	}

	# go2rtc HLS (single-origin avoids cross-origin/CORS for the player)
	handle_path /go2rtc/* {
		reverse_proxy go2rtc:1984
	}
}

player.conduit.local {
	reverse_proxy player:3001
}
