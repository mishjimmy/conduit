# Caddy reverse proxy for Conduit, serving over the internal CA on conduit.local.
#
#   conduit.local        -> CMS (operators)
#   conduitplayer.local  -> player (Pi kiosk)
#   conduitmqtt.local    -> Mosquitto websockets (wss for the player browser)
#
# All single-label .local names so they resolve over mDNS without /etc/hosts pins.
#
# Trust the Caddy internal CA root on every device: baked into the Pi image,
# imported once on operator/browser machines. Appwrite is external (its own TLS).

{
	# Issue certs from Caddy's local internal CA.
	local_certs
}

# External go2rtc (set GO2RTC_UPSTREAM=host:1984 in .env) is proxied under
# /go2rtc/ on both vhosts so its low-latency player (WebRTC/MSE) loads over https
# and its WebSocket upgrades work. handle_path strips the prefix before proxying.

conduit.local {
	handle_path /go2rtc/* {
		reverse_proxy {$GO2RTC_UPSTREAM}
	}
	handle {
		# CMS (management UI)
		reverse_proxy cms:3000
	}
}

conduitplayer.local {
	handle_path /go2rtc/* {
		reverse_proxy {$GO2RTC_UPSTREAM}
	}
	handle {
		reverse_proxy player:3001
	}
}

conduitmqtt.local {
	# Mosquitto's WebSocket listener (9001). Caddy terminates wss with the
	# internal CA; the player connects to wss://conduitmqtt.local.
	reverse_proxy mosquitto:9001
}
