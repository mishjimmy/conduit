# ─────────────────────────────────────────────────────────────
# Conduit on-prem server — copy to .env and fill in.
# Everything else has sane defaults in docker-compose.yml.
# ─────────────────────────────────────────────────────────────

# Remote Appwrite (same URL is used by both the browser and the server).
APPWRITE_ENDPOINT=https://appwrite.example.com/v1
APPWRITE_PROJECT_ID=conduit
APPWRITE_DATABASE_ID=conduit

# Server-side API key (CMS route handlers + bridge). Full scope for DB writes.
APPWRITE_API_KEY=
# Scoped key baked into the player device image. Storage read + player endpoints only.
PLAYER_API_KEY=

# Optional: weather widget on the player.
NEXT_PUBLIC_OPENWEATHER_API_KEY=

# ─────────────────────────────────────────────────────────────
# Advanced — only set these to override the compose defaults:
#   MQTT_URL=mqtt://mosquitto:1883          (server/bridge → broker)
#   GO2RTC_API_URL=http://go2rtc:1984       (CMS → go2rtc REST)
#   NEXT_PUBLIC_BASE_URL=https://conduit.local
#   NEXT_PUBLIC_GO2RTC_URL=https://conduit.local/go2rtc
#   NEXT_PUBLIC_MQTT_WS_URL=wss://conduitmqtt.local
#   NEXT_PUBLIC_PLAYER_VERSION=0.0.0
# ─────────────────────────────────────────────────────────────
