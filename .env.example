# ─────────────────────────────────────────────────────────────
# Conduit environment — copy to .env and fill in real values
# ─────────────────────────────────────────────────────────────

# Appwrite (self-hosted)
APPWRITE_ENDPOINT=http://localhost/v1
APPWRITE_PROJECT_ID=conduit
APPWRITE_DATABASE_ID=conduit
# Server-side API key (CMS route handlers + bridge). Full scope for DB writes.
APPWRITE_API_KEY=
# Scoped key baked into the player device image. Storage read + player endpoints only.
PLAYER_API_KEY=

# Public (browser) Appwrite config for the CMS client
NEXT_PUBLIC_APPWRITE_ENDPOINT=http://localhost/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=conduit
NEXT_PUBLIC_APPWRITE_DATABASE_ID=conduit

# MQTT broker (Mosquitto)
# Server-side (CMS routes, bridge) connect over TCP:
MQTT_URL=mqtt://localhost:1883
# Browser-side (player) connects over the WebSocket listener:
NEXT_PUBLIC_MQTT_WS_URL=ws://localhost:9001

# Public base URL used in pairing QR codes (points at the CMS /pair page)
NEXT_PUBLIC_BASE_URL=https://conduit.local

# go2rtc base URL the player browser uses for HLS (public/proxied)
NEXT_PUBLIC_GO2RTC_URL=http://localhost:1984
# go2rtc REST API the CMS uses server-side to add/remove streams live
# (in Docker Compose this is the service name: http://go2rtc:1984)
GO2RTC_API_URL=http://localhost:1984

# noVNC URL template for remote screen access ({host} = device Tailscale IP/name)
NEXT_PUBLIC_NOVNC_URL_TEMPLATE=http://{host}:6080/vnc.html?autoconnect=1&resize=scale

# Player build/runtime
NEXT_PUBLIC_PLAYER_VERSION=0.0.0
# Dev-only MAC override for the player when no ?mac= is supplied
DEVICE_MAC=AA:BB:CC:DD:EE:FF
